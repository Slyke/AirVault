        "@sveltejs/vite-plugin-svelte": "^6.2.0",
        "@tauri-apps/cli": "^2.10.0",
        "@types/node": "^26.6.5",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte-check": "^4.3.0",
        "typescript": "^5.9.0",
